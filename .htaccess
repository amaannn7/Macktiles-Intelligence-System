# Deny access to the data directory EXCEPT uploaded files (chat images/attachments)
# and Aircall call recordings (both need direct browser playback/download).
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Allow uploaded files to be served
    RewriteRule ^data/uploads/ - [L]
    # Allow Aircall call recordings to be played back
    RewriteRule ^data/recordings/ - [L]
    # Block everything else under data/
    RewriteRule ^data/ - [F,L]
</IfModule>

# Block access to sensitive files (json/log/md) anywhere
<FilesMatch "\.(json|log|md)$">
    Require all denied
</FilesMatch>

# But allow images and PDFs inside the uploads folder
<IfModule mod_rewrite.c>
    RewriteRule ^data/uploads/.*\.(png|jpe?g|gif|webp|pdf|csv|txt)$ - [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# index.html ships the whole SPA (all HTML/CSS/JS) and gets redeployed
# frequently — without an explicit no-cache directive here, browsers are
# free to keep serving a stale cached copy indefinitely on repeat visits,
# so a fix can be live on the server yet invisible to a user whose browser
# never re-fetches the file. Force a revalidation on every load instead.
<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
